{
  "name": "neurobot",
  "private": true,
  "version": "3.2.0",
  "description": "NeuroBot — jogo web (Phaser) para aprender redes neurais treinando um robô",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "deploy:hosting": "npm run build && npx --yes firebase-tools deploy --only hosting",
    "deploy:all": "npm run build && npx --yes firebase-tools deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "firebase": "^13.4.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
