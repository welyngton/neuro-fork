# Copie para .env.local para ligar Firebase/Analytics também em desenvolvimento
# (sem isso, `npm run dev` roda offline com localStorage). Produção usa .env.production.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=neuro-fork.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neuro-fork
VITE_FIREBASE_STORAGE_BUCKET=neuro-fork.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Emuladores locais (só em desenvolvimento)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
